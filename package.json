    "prisma:resolve-init-failure": "prisma migrate resolve --rolled-back 20260625170852_init_schema && prisma migrate resolve --applied 20260625170852_init_schema",
    "prisma:resolve-completed-hours-failure": "prisma migrate resolve --rolled-back 20260626140000_add_service_exchange_completed_hours",
    "prisma:seed": "prisma db seed",
    "seed:recommender": "tsx scripts/seed-recommender-dataset.ts",
    "seed:arabic": "tsx scripts/seed-arabic-demo.ts",
    "seed:wasla": "tsx scripts/seedWaslaData.ts",
    "test:recommender": "tsx scripts/test-recommender-production.ts",
    "cleanup:users": "tsx scripts/cleanup-users-keep-30.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
