  "scripts": {
    "test": "tsx --test src/**/*.test.ts",
    "dev": "nodemon --watch src --ext ts --exec tsx src/index.ts",
    "build": "prisma generate && tsc",
    "start": "sh scripts/migrate-deploy.sh && node dist/index.js",
