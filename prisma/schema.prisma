generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    Int                  @id @default(autoincrement())
  full_name             String
  username              String               @unique
  email                 String               @unique
  password_hash         String
  bio                   String?
  profile_image         String?
  available_balance     Int                  @default(5)
  escrow_balance        Int                  @default(0)
  services_provided     Int                  @default(0)
  services_received     Int                  @default(0)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  is_verified           Boolean              @default(false)
  location              String?
  passwordResetTokens   PasswordResetToken[]
  posts                 Post[]
  savedPosts            SavedPost[]
  sessions              Session[]
  received_transactions Transaction[]        @relation("Receiver")
  sent_transactions     Transaction[]        @relation("Sender")
  skills                UserSkill[]
  conversationsShare ConversationParticipant[]
  sender Message[]
  MessageRead MessageReadReceipt[]
  notifications Notification[]
  providedExchanges ServiceExchange[] @relation("ProvidedExchanges")
  receivedExchanges ServiceExchange[] @relation("ReceivedExchanges")
  reviewsGiven      Review[]          @relation("ReviewsGiven")
  reviewsReceived   Review[]          @relation("ReviewsReceived")
  @@map("users")
}

model Skill {
  id         Int         @id @default(autoincrement())
  skill_name String      @unique
  users      UserSkill[]

  @@map("skills")
}

model UserSkill {
  id         Int       @id @default(autoincrement())
  user_id    Int
  skill_id   Int
  skill_type skill_type
  created_at DateTime  @default(now())
  skill      Skill     @relation(fields: [skill_id], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, skill_id, skill_type])
  @@map("user_skills")
}

model Post {
  id                    Int         @id @default(autoincrement())
  user_id               Int
  title                 String
  description           String
  category              PostCategory
  service_mode          ServiceMode
  assigned_time_credits Int
  status                PostStatus  @default(PUBLISHED)
  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt
  user                  User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  savedBy               SavedPost[]

  conversations Conversation[]
  serviceExchanges ServiceExchange[]
  @@index([status])
  @@index([user_id])
  @@map("posts")
}

model SavedPost {
  id         Int      @id @default(autoincrement())
  user_id    Int
  post_id    Int
  created_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@index([post_id])
  @@map("saved_posts")
}

model Transaction {
  id                    Int             @id @default(autoincrement())
  receiver_id           Int
  sender_id             Int?
  amount                Int
  transaction_type      TransactionType
  reference_contract_id Int?
  created_at            DateTime        @default(now())
  receiver              User            @relation("Receiver", fields: [receiver_id], references: [id])
  sender                User?           @relation("Sender", fields: [sender_id], references: [id])

  @@map("transactions")
}

model Session {
  id            String   @id
  refresh_token String   @unique
  user_id       Int
  device_info   String
  ip_address    String?
  expires_at    DateTime
  is_revoked    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("session")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    Int
  tokenHash String    @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

enum skill_type {
  OFFER
  REQUEST
}

enum PostCategory {
  OFFER
  REQUEST
}

enum ServiceMode {
  ONLINE
  OFFLINE
}

enum PostStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum TransactionType {
  TRANSFER
  REFUND
  WELCOME_BONUS
}

enum NotificationType {
  NEW_MESSAGE
  CONVERSATION_STARTED
}

enum ServiceExchangeStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  WAITING_CONFIRMATION
  COMPLETED
  CANCELED
  REJECTED
  DISPUTED
}

enum EscrowStatus {
  NONE
  HELD
  RELEASED
  REFUNDED
}

model Conversation {
  id        String @id @default(cuid())
  postId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  @@map("conversations")

}

model ConversationParticipant{
  id String @id @default(cuid())
  conversationId String 
  userId Int
  joinedAt DateTime @default(now())


  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id String @id @default(cuid())
  senderId Int
  conversationId String
  body  String
  createdAt DateTime @default(now())
  editedAt DateTime?
  deletedAt DateTime?

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade) 
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  readReceipts MessageReadReceipt[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageReadReceipt {
  id String @id @default(cuid())
  messageId String
  userId Int
  readAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id] , onDelete: Cascade)
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_read_receipts")
}

model Notification {
  id        String           @id @default(cuid())
  userId    Int
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model ServiceExchange {
  id            Int                   @id @default(autoincrement())
  post_id       Int?
  provider_id   Int
  consumer_id   Int
  time_credits  Int
  status        ServiceExchangeStatus @default(PENDING)
  escrow_status EscrowStatus          @default(NONE)
  accepted_at   DateTime?
  delivered_at  DateTime?
  completed_at  DateTime?
  canceled_at   DateTime?
  created_at    DateTime              @default(now())
  updated_at    DateTime              @updatedAt

  post     Post?    @relation(fields: [post_id], references: [id], onDelete: SetNull)
  provider User     @relation("ProvidedExchanges", fields: [provider_id], references: [id])
  consumer User     @relation("ReceivedExchanges", fields: [consumer_id], references: [id])
  reviews  Review[]

  @@index([provider_id, status])
  @@index([consumer_id, status])
  @@index([status, completed_at])
  @@map("service_exchanges")
}

model Review {
  id                  Int      @id @default(autoincrement())
  service_exchange_id Int
  reviewer_id         Int
  reviewee_id         Int
  rating              Int
  comment             String
  created_at          DateTime @default(now())

  serviceExchange ServiceExchange @relation(fields: [service_exchange_id], references: [id], onDelete: Cascade)
  reviewer        User            @relation("ReviewsGiven", fields: [reviewer_id], references: [id])
  reviewee        User            @relation("ReviewsReceived", fields: [reviewee_id], references: [id])

  @@unique([service_exchange_id, reviewer_id])
  @@index([reviewee_id, created_at])
  @@map("reviews")
}