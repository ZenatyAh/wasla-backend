// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// generator client {
//   provider = "prisma-client"
//   output   = "../src/generated/prisma"
// }

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------
// 1. Users Table
// ----------------------------------------------------------------------
model User {
  id                Int     @id @default(autoincrement())
  full_name         String
  username          String  @unique
  email             String  @unique
  password_hash     String
  bio               String? // ? يعني أن الحقل اختياري (Nullable)
  profile_image     String?
  location          String?
  available_balance Int     @default(5)
  escrow_balance    Int     @default(0)

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  is_verified Boolean  @default(false)

  // العلاقات (Relations) - كيف يرتبط المستخدم بالجداول الأخرى
  skills UserSkill[]

  // حركات تم إرسالها أو استلامها بواسطة هذا المستخدم
  sent_transactions     Transaction[]        @relation("Sender")
  received_transactions Transaction[]        @relation("Receiver")
  sessions              session[]
  passwordResetTokens   PasswordResetToken[]
  posts                 POST[]

  @@map("users") // لتسمية الجدول الفعلي في الداتابيز بحروف صغيرة
}

// ----------------------------------------------------------------------
// 2. Skills Table (القائمة المرجعية للمهارات)
// ----------------------------------------------------------------------
model Skill {
  id         Int    @id @default(autoincrement())
  skill_name String @unique

  // العلاقات
  users UserSkill[]

  @@map("skills")
}

// ----------------------------------------------------------------------
// 3. User_Skills Table (الجدول الوسيط)
// ----------------------------------------------------------------------
// تعريف نوع المهارة (Offer أم Need)
enum SkillType {
  OFFER
  Request
}

model UserSkill {
  id         Int       @id @default(autoincrement())
  user_id    Int
  skill_id   Int
  skill_type SkillType

  created_at DateTime @default(now())

  // ربط المفاتيح الأجنبية (Foreign Keys)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  // لضمان عدم تكرار نفس المهارة لنفس المستخدم بنفس النوع (كعرض أو طلب)
  @@unique([user_id, skill_id, skill_type])
  @@map("user_skills")
}

// ----------------------------------------------------------------------
// 4. Transactions Table (سجل الحركات)
// ----------------------------------------------------------------------
// تعريف أنواع الحركات الممكنة
enum TransactionType {
  TRANSFER
  REFUND
  WELCOME_BONUS
}

model Transaction {
  id Int @id @default(autoincrement())

  // المُستلِم (دائماً موجود)
  receiver_id Int
  receiver    User @relation("Receiver", fields: [receiver_id], references: [id])

  // المُرسِل (قد يكون Null في حالة هدية التسجيل)
  sender_id Int?
  sender    User? @relation("Sender", fields: [sender_id], references: [id])

  amount           Int
  transaction_type TransactionType

  // مرجعية العقد (ستضيف علاقة العقد لاحقاً، حالياً سنكتفي بالرقم)
  reference_contract_id Int? // سنربطها بجدول Contract لاحقاً عندما ننشئه

  created_at DateTime @default(now())

  @@map("transactions")
}

model session {
  id            String   @id
  refresh_token String   @unique
  user_id       Int
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  device_info   String
  ip_address    String?
  expires_at    DateTime
  is_revoked    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @db.VarChar(255)
  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

enum FulfillmentType {
  Offline
  Online
}

enum PostStatus {
  AVAILABLE
  ARCHIVED
}

enum locationList {
  Gaza
  Rfah
  khanyounes
}

enum postType {
  OFFER
  REQUEST
}

model POST {
  id          String          @id @default(cuid())
  userId      Int
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        postType
  title       String
  description String
  timeCredits Int
  skill       String[]
  ServiceMode FulfillmentType
  status      PostStatus      @default(AVAILABLE)
  location    locationList?
  createdAt   DateTime        @default(now())
  updated_at  DateTime        @updatedAt
}
