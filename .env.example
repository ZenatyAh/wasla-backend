# Copy to .env and fill in values. In production, set these in your host/secret store.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wasla_db"

# Used by jsonwebtoken — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=

# Optional — password-reset HMAC; if omitted, JWT_SECRET is used (set separately for stricter isolation)
# TOKEN_SECRET=

# Optional
# PORT=3000
# NODE_ENV=production
# JSON_BODY_LIMIT=1mb

# Password reset email sender. Gmail requires an App Password, not your normal account password.
EMAIL_USER=
EMAIL_PASSWORD=

# Preferred for production email delivery (used before Gmail when set).
RESEND_API_KEY=your_api_key_here
# Must be a verified sender/domain in Resend. Dev default: onboarding@resend.dev
# RESEND_FROM=Wasla <noreply@yourdomain.com>

# Frontend URL — used for CORS allowlist and reset-password email links.
FRONTEND_URL=http://localhost:3000

# Clerk authentication
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
# Optional — password reset redirect target when not using embedded Clerk UI
CLERK_ACCOUNT_PORTAL_URL=https://your-app.accounts.dev

# Recommender (FastAPI) integration. Leave URL/KEY blank to disable cleanly.
# RECOMMENDER_URL is the base URL of the FastAPI service (e.g. http://recommender:8000).
# RECOMMENDER_API_KEY is the shared secret; it is sent as X-Internal-Token on
# outbound sync calls AND required on the inbound /internal/recommender-export endpoint.
RECOMMENDER_URL=
RECOMMENDER_API_KEY=
RECOMMENDER_TIMEOUT_MS=5000
